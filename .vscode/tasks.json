{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build Clang PCH Local",
      "command": "/usr/bin/clang++",
      "args": [
        "-std=c++17",
        "-I${workspaceFolder}",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}